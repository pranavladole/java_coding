		#most occuring and least occuring 
    
		int most = numbers.stream().collect(Collectors.groupingBy(Function.identity(),Collectors.counting()))
					.entrySet()
					.stream()
					.max(Map.Entry.comparingByValue())
					.map(Map.Entry::getKey)
					.orElse(-1);
			
		System.out.println(most);
		
		int least = numbers.stream().collect(Collectors.groupingBy(Function.identity(),Collectors.counting()))
				.entrySet()
				.stream()
				.min(Map.Entry.comparingByValue())
				.map(Map.Entry::getKey)
				.orElse(-1);
		
		System.out.println(least);
    
