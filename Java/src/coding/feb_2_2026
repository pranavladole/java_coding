# find dup

		List<Integer> numbers = Arrays.asList(1, 2, 3, 2, 4, 5, 1, 6);

		List<Integer> dup = numbers.stream().collect(Collectors.groupingBy(Function.identity(), Collectors.counting()))
				.entrySet().stream().filter(n -> n.getValue() > 1).map(Map.Entry::getKey).toList();
		System.out.println(dup);

